generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  role_id         String         @db.Uuid
  status          String         @default("pending")
  email_verified  Boolean        @default(false)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  password        String
  cart_items      CartItem[]
  notifications   Notification[]
  buyer_orders    Order[]        @relation("BuyerOrders")
  supplier_orders Order[]        @relation("SupplierOrders")
  products        Product[]
  circular_products CircularProduct[]
  profile         Profile?
  qc_results      QcResult[]
  buyer_rfqs      RfqRequest[]   @relation("BuyerRfqs")
  supplier_rfqs   RfqRequest[]   @relation("SupplierRfqs")
  rfq_responses   RfqResponse[]
  role            Role           @relation(fields: [role_id], references: [id])
  wallet          Wallet?
  supplier_profile SupplierProfile?
  auth_sessions   AuthSession[]
  quality_requests TestingRequest[]

  @@map("users")
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions Json     @default("{}")
  created_at  DateTime @default(now())
  users       User[]

  @@map("roles")
}

model Profile {
  id             String  @id @default(uuid()) @db.Uuid
  user_id        String  @unique @db.Uuid
  company_name   String?
  legal_number   String?
  npwp           String?
  chairman_name  String?
  country        String?
  contact_person String?
  phone          String?
  address        String?
  postal_code    String?
  area_id        String?
  avatar_url     String?
  user           User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Product {
  id                  String             @id @default(uuid()) @db.Uuid
  supplier_id         String             @db.Uuid
  batch_code          String             @unique
  status              String             @default("DRAFT")
  origin_village      String?
  origin_district     String?
  origin_province     String?
  production_date     DateTime?
  total_volume_kg     Float
  available_volume_kg Float
  moq_kg              Float              @default(1.0)
  price_per_kg        Float
  images              String[]           @default([])
  is_featured         Boolean            @default(false)
  is_demo             Boolean            @default(false)
  price_type          String             @default("OFFER")
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  cart_items          CartItem[]
  certificate         Certificate?
  order_items         OrderItem[]
  parameters          ProductParameter[]
  supplier            User               @relation(fields: [supplier_id], references: [id])
  qc_result           QcResult?
  rfq_responses       RfqResponse[]
  trace_logs          TraceLog[]
  testing_requests    TestingRequest[]
  lab_reports         LabReport[]
  quality_files       QualityFile[]

  @@map("products")
}

model ProductParameter {
  id             String  @id @default(uuid()) @db.Uuid
  product_id     String  @db.Uuid
  parameter_name String
  value          Float
  unit           String
  standard_min   Float?
  standard_max   Float?
  status         String  @default("UNEVALUATED")
  product        Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_parameters")
}

model QcResult {
  id               String       @id @default(uuid()) @db.Uuid
  product_id       String       @unique @db.Uuid
  admin_id         String       @db.Uuid
  pa_percentage    Float?
  moisture         Float?
  specific_gravity Float?
  refractive_index Float?
  optical_rotation Float?
  overall_status   String       @default("UNEVALUATED")
  tested_at        DateTime?
  lab_name         String?
  report_number    String?
  source_document_url String?
  evaluation_rule_version String?
  lab_notes        String?
  certificate      Certificate?
  admin            User         @relation(fields: [admin_id], references: [id])
  product          Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("qc_results")
}

model Certificate {
  id                  String   @id @default(uuid()) @db.Uuid
  product_id          String   @unique @db.Uuid
  qc_result_id        String   @unique @db.Uuid
  certificate_number  String   @unique
  issued_at           DateTime @default(now())
  admin_name          String
  admin_signature_url String?
  pdf_url             String?
  qr_code_url         String?
  review_status       String   @default("NEEDS_REVIEW")
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  qc_result           QcResult @relation(fields: [qc_result_id], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model TestingPartner {
  id String @id @default(uuid()) @db.Uuid
  name String
  kind String @default("LABORATORY")
  logo_url String?
  address String?
  contact String?
  services String[] @default([])
  instructions String?
  fees String?
  sample_requirements String?
  turnaround String?
  result_channel String?
  permission_notes String?
  publish_name Boolean @default(false)
  publish_logo Boolean @default(false)
  publish_reports Boolean @default(false)
  visible Boolean @default(false)
  accepting_requests Boolean @default(false)
  status String @default("EXPLORATORY")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  requests TestingRequest[]
  reports LabReport[]
  files QualityFile[]
  @@map("testing_partners")
}

model TestingRequest {
  id String @id @default(uuid()) @db.Uuid
  number String @unique
  supplier_id String @db.Uuid
  product_id String @db.Uuid
  partner_id String @db.Uuid
  partner_snapshot Json
  service String
  sample_identity String?
  notes String?
  shipping_info String?
  shipping_evidence String?
  status String @default("SUBMITTED")
  request_key String @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  supplier User @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  partner TestingPartner @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  reports LabReport[]
  events QualityEvent[]
  @@index([supplier_id, created_at])
  @@map("testing_requests")
}

model QualityFile {
  id String @id @default(uuid()) @db.Uuid
  product_id String? @db.Uuid
  partner_id String? @db.Uuid
  uploaded_by String @db.Uuid
  storage_path String @unique
  name String
  size Int
  sha256 String
  created_at DateTime @default(now())
  partner TestingPartner? @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  reports LabReport[]
  product Product? @relation(fields: [product_id], references: [id], onDelete: Restrict, map: "quality_files_product_fk")
  @@map("quality_files")
}

model LabReport {
  id String @id @default(uuid()) @db.Uuid
  product_id String @db.Uuid
  request_id String? @db.Uuid
  partner_id String @db.Uuid
  issuer_snapshot Json
  report_number String
  sample_identity String
  tested_at DateTime?
  issued_at DateTime?
  file_id String @db.Uuid
  parameters Json @default("[]")
  conclusion String?
  source String
  uploaded_by String @db.Uuid
  review_status String @default("PENDING")
  review_notes String?
  review_checklist Json?
  reviewed_by String? @db.Uuid
  reviewed_at DateTime?
  publication_allowed Boolean @default(false)
  is_demo Boolean @default(false)
  evaluation_status String @default("UNEVALUATED")
  replaces_id String? @db.Uuid
  request_key String @unique
  created_at DateTime @default(now())
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  request TestingRequest? @relation(fields: [request_id], references: [id], onDelete: Restrict)
  partner TestingPartner @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  file QualityFile @relation(fields: [file_id], references: [id], onDelete: Restrict)
  replaces LabReport? @relation("ReportVersions", fields: [replaces_id], references: [id], onDelete: Restrict)
  replacements LabReport[] @relation("ReportVersions")
  events QualityEvent[]
  @@index([product_id, review_status])
  @@map("lab_reports")
}

model QualityEvent {
  id String @id @default(uuid()) @db.Uuid
  request_id String? @db.Uuid
  report_id String? @db.Uuid
  actor_id String @db.Uuid
  actor_role String
  action String
  notes String?
  evidence String?
  action_key String @unique
  created_at DateTime @default(now())
  request TestingRequest? @relation(fields: [request_id], references: [id], onDelete: Restrict)
  report LabReport? @relation(fields: [report_id], references: [id], onDelete: Restrict)
  @@map("quality_events")
}

model TraceLog {
  id                String   @id @default(uuid()) @db.Uuid
  product_id        String   @db.Uuid
  event_type        String
  location_name     String
  location_district String?
  gps_latitude      Float?
  gps_longitude     Float?
  description       String?
  event_date        DateTime @default(now())
  created_at        DateTime @default(now())
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("trace_logs")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  order_number     String      @unique
  buyer_id         String      @db.Uuid
  supplier_id      String      @db.Uuid
  status           String      @default("PENDING")
  total_amount     Float
  shipping_cost    Float       @default(0)
  shipping_address Json        @default("{}")
  payment_status   String      @default("PENDING")
  delivery_proof_url String?
  stock_state      String      @default("NONE")
  reservation_expires_at DateTime?
  checkout_key     String?     @unique
  checkout_fingerprint String?
  rfq_id           String?     @unique @db.Uuid
  rfq              RfqRequest? @relation(fields: [rfq_id], references: [id])
  created_at       DateTime    @default(now())
  items            OrderItem[]
  buyer            User        @relation("BuyerOrders", fields: [buyer_id], references: [id])
  supplier         User        @relation("SupplierOrders", fields: [supplier_id], references: [id])
  payment          Payment?
  shipment         Shipment?

  @@map("orders")
}

model OrderItem {
  id                  String           @id @default(uuid()) @db.Uuid
  order_id            String           @db.Uuid
  product_id          String?          @db.Uuid
  circular_product_id String?          @db.Uuid
  quantity_kg         Float
  price_per_kg        Float
  subtotal            Float
  order               Order            @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product             Product?         @relation(fields: [product_id], references: [id], onDelete: Restrict)
  circular_product    CircularProduct? @relation(fields: [circular_product_id], references: [id])

  @@map("order_items")
}

model Payment {
  id                 String    @id @default(uuid()) @db.Uuid
  order_id           String    @unique @db.Uuid
  payment_method     String?
  payment_gateway_id String?
  gateway_order_id   String?   @unique
  snap_token         String?
  amount             Float
  status             String    @default("pending")
  paid_at            DateTime?
  order              Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum ShipmentType {
  DOMESTIK
  EKSPOR
}

enum ShipmentStatus {
  MENUNGGU_KONFIRMASI
  TERKONFIRMASI
  DIPROSES
  DIKIRIM
  DALAM_PERJALANAN
  TIBA_DI_TUJUAN
  SELESAI
  BERMASALAH
  DIBATALKAN
}

enum Incoterms {
  EXW
  FOB
  CIF
}

model Shipment {
  id                  String         @id @default(uuid()) @db.Uuid
  order_id            String         @unique @db.Uuid
  shipment_type       ShipmentType   @default(DOMESTIK)

  // === DOMESTIK (Biteship) ===
  biteship_rate_id    String?        
  courier_name        String?        
  courier_code        String?        
  service_name        String?        
  service_code        String?        
  estimated_days      Int?           

  // Komponen biaya domestik
  base_shipping_cost  Decimal?       @db.Decimal(15, 2)
  insurance_fee       Decimal?       @db.Decimal(15, 2)
  packaging_fee       Decimal?       @db.Decimal(15, 2)
  total_shipping_cost Decimal?       @db.Decimal(15, 2)

  // Dimensi & Berat
  actual_weight       Decimal?       @db.Decimal(10, 3)
  volumetric_weight   Decimal?       @db.Decimal(10, 3)
  billed_weight       Decimal?       @db.Decimal(10, 3)
  drum_count          Int?

  // Tracking info
  tracking_number     String?
  tracking_url        String?
  last_tracking_data  Json?          

  // === EKSPOR ===
  incoterms           Incoterms?
  port_origin         String?        
  port_destination    String?        
  forwarder_name      String?
  estimated_freight   Decimal?       @db.Decimal(15, 2)  
  export_notes        String?

  // Snapshot Alamat
  origin_address      Json          
  destination_address Json          

  // Status & Timestamps
  status              ShipmentStatus @default(MENUNGGU_KONFIRMASI)
  shipped_at          DateTime?
  estimated_arrival   DateTime?
  delivered_at        DateTime?
  completed_at        DateTime?
  issue_notes         String?

  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  order               Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  tracking_logs       ShipmentTrackingLog[]

  @@map("shipments")
}

model ShipmentTrackingLog {
  id          String   @id @default(uuid()) @db.Uuid
  shipment_id String   @db.Uuid
  status      String
  description String
  location    String?
  raw_data    Json?    
  created_at  DateTime @default(now())
  shipment    Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@map("shipment_tracking_logs")
}

model CartItem {
  id                  String           @id @default(uuid()) @db.Uuid
  user_id             String           @db.Uuid
  product_id          String?          @db.Uuid
  circular_product_id String?          @db.Uuid
  quantity_kg         Float
  created_at          DateTime         @default(now())
  product             Product?         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  circular_product    CircularProduct? @relation(fields: [circular_product_id], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  user_id      String              @unique @db.Uuid
  balance      Decimal             @default(0.0) @db.Decimal(15, 2)
  refund_due   Decimal             @default(0.0) @db.Decimal(15, 2)
  frozen       Boolean             @default(false)
  updated_at   DateTime            @updatedAt
  transactions WalletTransaction[]
  user         User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  withdrawals  Withdrawal[]

  @@map("wallets")
}

model WalletTransaction {
  id                 String   @id @default(uuid()) @db.Uuid
  wallet_id          String   @db.Uuid
  type               String
  amount             Decimal  @db.Decimal(15, 2)
  reference_order_id String?
  description        String?
  created_at         DateTime @default(now())
  wallet             Wallet   @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@unique([reference_order_id, type])

  @@map("wallet_transactions")
}

model Withdrawal {
  id                  String    @id @default(uuid()) @db.Uuid
  wallet_id           String    @db.Uuid
  amount              Decimal   @db.Decimal(15, 2)
  bank_name           String
  account_number      String
  account_holder_name String
  status              String    @default("PENDING")
  request_key         String?   @unique
  requested_at        DateTime  @default(now())
  processed_at        DateTime?
  wallet              Wallet    @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model RfqRequest {
  id                String       @id @default(uuid()) @db.Uuid
  rfq_number        String       @unique
  buyer_id          String       @db.Uuid
  supplier_id       String       @db.Uuid
  volume_kg         Float
  budget_per_kg     Float
  min_pa_percentage Float
  max_moisture      Float
  notes             String?
  status            String       @default("SENT")
  created_at        DateTime     @default(now())
  buyer             User         @relation("BuyerRfqs", fields: [buyer_id], references: [id])
  supplier          User         @relation("SupplierRfqs", fields: [supplier_id], references: [id])
  response          RfqResponse?
  order             Order?

  @@map("rfq_requests")
}

model RfqResponse {
  id                    String     @id @default(uuid()) @db.Uuid
  rfq_id                String     @unique @db.Uuid
  supplier_id           String     @db.Uuid
  proposed_price_per_kg Float
  proposed_volume_kg    Float
  message               String?
  status                String     @default("RESPONDED")
  responded_at          DateTime   @default(now())
  product_id            String?    @db.Uuid
  expires_at            DateTime?
  product               Product?   @relation(fields: [product_id], references: [id])
  rfq_request           RfqRequest @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  supplier              User       @relation(fields: [supplier_id], references: [id])

  @@map("rfq_responses")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  type       String
  title      String
  message    String
  is_read    Boolean  @default(false)
  action_url String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ── Supplier Verification Enums ───────────────────────────────────

enum SupplierStatus {
  TERDAFTAR
  DALAM_VERIFIKASI
  TERVERIFIKASI
  LEGACY_VERIFIED
}

enum GradeNilam {
  GRADE_A
  GRADE_B
  GRADE_C
}

enum SupplierSubtype {
  PETANI
  PENYULING
  KOPERASI
}

enum TipeDocument {
  AKTA_KOPERASI
  COA
  FOTO_FASILITAS
  SURAT_PERNYATAAN
}

enum StatusDokumen {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum AksiVerifikasi {
  APPROVE_DOCUMENT
  REJECT_DOCUMENT
  REQUEST_REVISION
  FINALIZE_VERIFIED
  RESET_TO_TERDAFTAR
  LEGACY_REMINDER_SENT
  LEGACY_DEADLINE_ENFORCED
}

// ── Supplier Verification Models ──────────────────────────────────

model SupplierProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  user_id            String             @unique @db.Uuid

  // ── Sub-tipe Supplier ──────────────────────────────────────────
  supplier_subtype   SupplierSubtype    @default(KOPERASI)

  // ── Shared Fields (semua sub-tipe) ─────────────────────────────
  nama_pic           String             // Petani/Penyuling: "Nama Lengkap (KTP)", Koperasi: "Nama Ketua/PIC"
  ktp_pic            String             // NIK KTP (16 digit)
  whatsapp           String
  kabupaten          String
  kecamatan          String
  desa               String

  // ── Koperasi-specific (nullable untuk Petani/Penyuling) ────────
  nama_koperasi      String?
  nib                String?
  npwp               String?
  alamat_lengkap     String?

  // ── Kapasitas (Penyuling & Koperasi wajib, Petani conditional) ─
  kapasitas_produksi Float?

  // ── Petani-specific ────────────────────────────────────────────
  luas_lahan         Float?             // Estimasi Luas Lahan (Ha)
  estimasi_panen     Float?             // Estimasi Panen (kg/bulan, daun basah)
  punya_alat_suling  Boolean            @default(false)

  // ── Relasi Koperasi Pembina (opsional, untuk Petani/Penyuling) ─
  koperasi_pembina_id String?           @db.Uuid
  koperasi_pembina    SupplierProfile?  @relation("KoperasiAnggota", fields: [koperasi_pembina_id], references: [id])
  anggota_binaan      SupplierProfile[] @relation("KoperasiAnggota")

  // Opsional — rekening bank
  nomor_rekening     String?
  nama_bank          String?
  nama_rekening      String?

  // Storefront Additional Data
  tahun_berdiri      String?
  jumlah_anggota     Int?               @default(15)
  minimum_order      Float?             @default(10)
  durasi_produksi    String?            @default("7-14 Hari")
  metode_distilasi   String?            @default("Uap (Steam Distillation)")
  bahan_baku         String?            @default("100% Daun Nilam Segar")
  website            String?
  postal_code        String?
  area_id            String?

  // Grade & Status
  grade_nilam        GradeNilam[]
  status             SupplierStatus     @default(TERDAFTAR)

  // Legacy
  is_legacy          Boolean            @default(false)
  legacy_deadline    DateTime?

  // Timestamps
  verified_at        DateTime?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  // Relations
  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  documents          SupplierDocument[]
  verification_logs  VerificationLog[]

  @@index([status])
  @@index([supplier_subtype])
  @@map("supplier_profiles")
}

model SupplierDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  supplier_id        String             @db.Uuid
  tipe_document      TipeDocument
  file_url           String
  file_name          String
  file_size          Int
  status_dokumen     StatusDokumen      @default(PENDING)
  catatan_reviewer   String?
  tanggal_coa        DateTime?
  reviewed_at        DateTime?
  reviewed_by        String?            @db.Uuid
  uploaded_at        DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  supplier           SupplierProfile    @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  verification_logs  VerificationLog[]

  @@index([supplier_id, tipe_document])
  @@map("supplier_documents")
}

model VerificationLog {
  id                 String             @id @default(uuid()) @db.Uuid
  supplier_id        String             @db.Uuid
  admin_id           String             @db.Uuid
  aksi               AksiVerifikasi
  document_id        String?            @db.Uuid
  catatan            String?
  created_at         DateTime           @default(now())

  supplier           SupplierProfile    @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  document           SupplierDocument?  @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([supplier_id])
  @@map("verification_logs")
}

model CircularProduct {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier_id      String      @db.Uuid
  name             String
  category         String      // Organic Compost, Biochar, Patchouli Hydrosol
  description      String
  benefit          String
  price            Float
  stock            Float
  unit             String
  image            String?     @default("")
  status           String      @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  rejection_reason String?     
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  supplier         User        @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  cart_items       CartItem[]
  order_items      OrderItem[]

  @@map("circular_products")
}

