# ──────────────────────────────────────────────────────────────────────
# VALAM Backend - Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────
# Transaction-mode pooler (for app runtime)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session-mode pooler (for migrations)
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Supabase ────────────────────────────────────────────────────────
# Wajib: secret acak minimal 32 karakter; jangan commit nilai .env lokal.
JWT_SECRET=
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx

# ─── Grok / xAI (Nila chatbot) ──────────────────────────────────────
GROK_API_KEY=your_grok_api_key_here
# Optional — defaults to grok-4-1-fast-non-reasoning
GROK_MODEL=grok-4-1-fast-non-reasoning

# ─── Biteship Shipping API ──────────────────────────────────────────
# API key dari dashboard Biteship (https://app.biteship.com)
BITESHIP_API_KEY=biteship_test_xxxxxxxxxxxx
# Base URL (jangan diubah kecuali Biteship pindah domain)
BITESHIP_BASE_URL=https://api.biteship.com
# Mode: "sandbox" (mock fallback diizinkan) atau "production" (error langsung dilempar)
BITESHIP_ENV=sandbox
# Webhook signature: nama header yang dikirim Biteship (dikonfigurasi di dashboard)
BITESHIP_WEBHOOK_SIGNATURE_KEY=x-biteship-signature
# Webhook token: nilai secret yang dicek dari header di atas
BITESHIP_WEBHOOK_TOKEN=your_webhook_secret_here

# ─── Midtrans Payment ───────────────────────────────────────────────
# JANGAN expose Server Key ke frontend!
# Sandbox keys for local testing; obtain the matching pair from Sandbox > Access Keys.
# The dashboard environment determines the key's usage; do not infer it from a prefix.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Konfigurasi Shipment ───────────────────────────────────────────
SHIPMENT_BATAS_BERAT_OTOMATIS=500
SHIPMENT_MIN_BERAT_DOMESTIK=50
SHIPMENT_TARIF_ASURANSI=0.002
SHIPMENT_BIAYA_PENGEMASAN_DRUM=50000

# Public QR destination (no guessed production domain)
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_DEFAULT_LOCALE=id
