# Normalize text files
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Prisma
*.prisma text eol=lf

# Documentation
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf